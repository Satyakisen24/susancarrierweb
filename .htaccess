RewriteEngine on
Options -Indexes

RewriteCond %{HTTP_REFERER} !^http://susancarrier.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://susancarrier.com$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.susancarrier.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.susancarrier.com$      [NC]
RewriteCond %{HTTP_REFERER} !^https://susancarrier.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://susancarrier.com$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.susancarrier.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.susancarrier.com$      [NC]
RewriteRule .*\.(jpg|jpeg|gif|png|bmp)$ - [F,NC]
RewriteCond %{HTTP_HOST} ^susancarrier\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.susancarrier\.com$
RewriteRule ^/?$ "https\:\/\/www\.susancarrier\.com\/index\.php" [R=301,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php71” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php71 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
